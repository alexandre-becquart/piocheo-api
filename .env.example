PORT=3100
HOST=127.0.0.1
PIOCHEO_MONGODB_URI=mongodb://127.0.0.1:27029/piocheo_dev
PIOCHEO_DEMO_CITY=Tournai
# Générer une valeur indépendante avec openssl rand -hex 32
PIOCHEO_JWT_SECRET=
# E-mails (mot de passe oublié) via Resend, comme Wayd. Sans clé en local, le lien s'affiche dans la console.
RESEND_API_KEY=
EMAIL_FROM=Piochéo <noreply@piocheo.com>
# Connexion Google (identifiants OAuth « Application Web » dans Google Cloud Console). Vide = bouton désactivé.
PIOCHEO_GOOGLE_CLIENT_ID=
PIOCHEO_GOOGLE_CLIENT_SECRET=
# Retour Google : http://localhost:3100/auth/google/callback en local, https://api.piocheo.com/... en production.
# Les adresses de production (piocheo.com, api.piocheo.com) sont dans le code, comme sur Wayd.
# Facultatif : PIOCHEO_WEB_ORIGINS pour des origines en plus, PIOCHEO_WEB_URL, PIOCHEO_TRUST_PROXY.
